# Copie para .env (nesta pasta) e preencha. O .env não vai para o git.
# O que está aqui vale mais do que as variáveis do terminal.

TYPESAFE_API_KEY=

# Modelo do Jev. Fixe a versão (jev-1.13.0, jev-1.14.0) se for afinar limiares;
# jev-latest e jev-preview são apelidos que mudam sozinhos.
JEV_MODEL=jev-1.13.0

PORTA=3000
